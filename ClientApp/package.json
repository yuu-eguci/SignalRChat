{
  "name": "signalrchat-client",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.20.0",
  "engines": {
    "node": ">=26.13.1 <27",
    "npm": ">=11.20.0 <12"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint --flag unstable_native_nodejs_ts_config --max-warnings 0 .",
    "test": "node --test tests/chat.test.ts",
    "build": "npm run typecheck && node scripts/build.ts",
    "e2e": "node --test e2e/chat.test.ts"
  },
  "dependencies": {
    "@microsoft/signalr": "10.0.11",
    "bootstrap": "5.3.9"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "jsdom": "31.0.1",
    "playwright-core": "1.65.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
